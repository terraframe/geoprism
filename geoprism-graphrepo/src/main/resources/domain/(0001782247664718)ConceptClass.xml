<version xsi:noNamespaceSchemaLocation="classpath:com/runwaysdk/resources/xsd/version.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <doIt>
    <create>
      <mdVertex
        name="net.geoprism.registry.graph.ConceptClass"
        label="Concept Class"
        extends="net.geoprism.registry.graph.ObjectClass">
        <attributes>
          <reference
            name="mdVertex"
            type="com.runwaysdk.system.metadata.MdVertex"
            required="true"
            label="MdVertex" />
          <localCharEmbedded
            name="displayLabel"
            label="Label"
            required="true" />
          <graphReference name="organization" label="Organization" type="net.geoprism.registry.graph.GraphOrganization" />
          <text name="origin" label="Origin"  />                   
          <long name="sequence" label="Sequence"  />                                        
        </attributes>
      </mdVertex>
    </create>
    <update></update>
    <permissions>
      <role roleName="geoprism.admin.Administrator">
        <grant>
          <mdBusinessPermission type="net.geoprism.registry.graph.ConceptClass">
            <operation name="ALL" />
          </mdBusinessPermission>
        </grant>
      </role>
    </permissions>
  </doIt>
  <undoIt>
    <delete>
      <object
        key="net.geoprism.registry.graph.ConceptClass"
        type="com.runwaysdk.system.metadata.MdVertex"></object>
    </delete>
  </undoIt>
</version>