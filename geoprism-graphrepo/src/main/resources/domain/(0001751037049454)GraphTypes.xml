<version xsi:noNamespaceSchemaLocation="classpath:com/runwaysdk/resources/xsd/version.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <doIt>
    <create>
      <mdVertex name="net.geoprism.registry.graph.DirectedAcyclicGraphType" extends="net.geoprism.registry.graph.GeoEdgeClass" label="Directed Acyclic Graph">
        <attributes>
          <reference name="mdEdge" type="com.runwaysdk.system.metadata.MdEdge" required="true" label="MdEdge" />   
          <text name="origin" label="Origin"  />                   
          <long name="sequence" label="Sequence"  />                                               
        </attributes>
      </mdVertex>    
      <mdVertex name="net.geoprism.registry.graph.UndirectedGraphType" extends="net.geoprism.registry.graph.GeoEdgeClass" label="Directed Acyclic Graph">
        <attributes>
          <reference name="mdEdge" type="com.runwaysdk.system.metadata.MdEdge" required="true" label="MdEdge" />        
          <text name="origin" label="Origin"  />                   
          <long name="sequence" label="Sequence"  />                                          
        </attributes>
      </mdVertex>    
    </create>
    
    <permissions>
      <role roleName="geoprism.admin.Administrator">
        <grant>
          <mdBusinessPermission type="net.geoprism.registry.graph.DirectedAcyclicGraphType">
            <operation name="ALL" />
          </mdBusinessPermission>
          <mdBusinessPermission type="net.geoprism.registry.graph.UndirectedGraphType">
            <operation name="ALL" />
          </mdBusinessPermission>
        </grant>
      </role>
    </permissions>
    
  </doIt>
  <undoIt>
    <delete>
      <object type="com.runwaysdk.system.metadata.MdBusiness" key="net.geoprism.registry.graph.DirectedAcyclicGraphType" />
      <object type="com.runwaysdk.system.metadata.MdBusiness" key="net.geoprism.registry.graph.UndirectedGraphType" />
    </delete>
  </undoIt>
</version>