<version
  xsi:noNamespaceSchemaLocation="classpath:com/runwaysdk/resources/xsd/version.xsd"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <doIt>
    <create>
      <mdVertex
        name="net.geoprism.registry.graph.ConceptSet"
        extends="net.geoprism.registry.graph.SchemaElement"
        isAbstract="true"
        label="Concept Set">
        <attributes>
          <char
            name="code"
            label="Code"
            required="true"
            size="255"
            indexType="unique" />
          <localCharEmbedded
            name="displayLabel"
            label="Label"
            required="true" />
          <localCharEmbedded
            name="description"
            label="Description" />
        </attributes>
      </mdVertex>
      <mdVertex
        name="net.geoprism.registry.graph.Taxonomy"
        extends="net.geoprism.registry.graph.ConceptSet"
        isAbstract="false"
        label="Taxonomy">
      </mdVertex>
      <mdVertex
        name="net.geoprism.registry.graph.Ontology"
        extends="net.geoprism.registry.graph.ConceptSet"
        isAbstract="false"
        label="Ontology">
      </mdVertex>
      <mdVertex
        name="net.geoprism.registry.graph.Enumeration"
        extends="net.geoprism.registry.graph.ConceptSet"
        isAbstract="false"
        label="Geo Ontology">
      </mdVertex>
      
      <mdEdge name="net.geoprism.registry.graph.HasConcept" label="Has Concept" parent="net.geoprism.registry.graph.ConceptSet" child="net.geoprism.registry.graph.ConceptClass" generateSource="false">
      </mdEdge>
      
      <mdEdge name="net.geoprism.registry.graph.HasConceptEdge" label="Has Concept Edge" parent="net.geoprism.registry.graph.ConceptSet" child="net.geoprism.registry.graph.ConceptEdgeType" generateSource="false">
      </mdEdge>

    </create>

    <permissions>
      <role roleName="geoprism.admin.Administrator">
        <grant>
          <mdBusinessPermission type="net.geoprism.registry.graph.ConceptSet">
            <operation name="ALL" />
          </mdBusinessPermission>
          <mdBusinessPermission type="net.geoprism.registry.graph.Taxonomy">
            <operation name="ALL" />
          </mdBusinessPermission>
          <mdBusinessPermission type="net.geoprism.registry.graph.Ontology">
            <operation name="ALL" />
          </mdBusinessPermission>
          <mdBusinessPermission type="net.geoprism.registry.graph.Enumeration">
            <operation name="ALL" />
          </mdBusinessPermission>
          <mdRelationshipPermission type="net.geoprism.registry.graph.HasConcept">
            <operation name="ALL" />
          </mdRelationshipPermission>
          <mdRelationshipPermission type="net.geoprism.registry.graph.HasConceptEdge">
            <operation name="ALL" />
          </mdRelationshipPermission>
        </grant>
      </role>

    </permissions>

  </doIt>
  <undoIt>
    <delete>
      <object
        type="com.runwaysdk.system.metadata.MdEdge"
        key="net.geoprism.registry.graph.HasConceptEdge" />
      <object
        type="com.runwaysdk.system.metadata.MdEdge"
        key="net.geoprism.registry.graph.HasConcept" />
      <object
        type="com.runwaysdk.system.metadata.MdVertex"
        key="net.geoprism.registry.graph.Enumeration" />
      <object
        type="com.runwaysdk.system.metadata.MdVertex"
        key="net.geoprism.registry.graph.Ontology" />
      <object
        type="com.runwaysdk.system.metadata.MdVertex"
        key="net.geoprism.registry.graph.Taxonomy" />
      <object
        type="com.runwaysdk.system.metadata.MdVertex"
        key="net.geoprism.registry.graph.ConceptSet" />
    </delete>
  </undoIt>
</version>